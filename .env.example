# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Storage
# Backend is chosen at runtime: Neon/Postgres -> Supabase -> Redis -> local files.
# Leave everything blank locally to write to ./data
# ---------------------------------------------------------------------------

# Neon / Postgres (recommended). Run db/schema.sql once to create the tables.
# Vercel's Neon integration injects DATABASE_URL automatically.
DATABASE_URL=
# Also accepted: POSTGRES_URL, NEON_DATABASE_URL, DATABASE_URL_UNPOOLED

# Supabase alternative. Run db/schema.sql plus the RLS lines at its end.
# VITE_SUPABASE_URL is accepted as an alias for SUPABASE_URL.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# Only needed if a browser talks to Supabase directly. This site does not.
# VITE_SUPABASE_ANON_KEY=

# Redis alternative (Vercel KV / Upstash). Either naming pair works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Override where local file storage writes (defaults to ./data, /tmp on Vercel)
DATA_DIR=

# ---------------------------------------------------------------------------
# Outgoing email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Where enquiries and chat notifications are delivered.
FORM_TO=you@yourdomain.com
# Verified sender in Resend. onboarding@resend.dev works for testing.
FORM_FROM=Merkel Website <onboarding@resend.dev>

# Legacy aliases, still honoured if FORM_TO / FORM_FROM are unset.
# CONTACT_NOTIFY_EMAIL=
# NOTIFY_FROM=

# Send a notification for every live-chat message. Set to "off" to silence.
CHAT_NOTIFY=on

# ---------------------------------------------------------------------------
# Inbound email (Resend receiving + forwarding)
# ---------------------------------------------------------------------------
# Signing secret from the Resend webhook. Requests without a valid
# signature are rejected with 401.
RESEND_WEBHOOK_SECRET=

# The address that receives mail, e.g. studio@yourdomain.com
MAILBOX_ADDRESS=

# Where received mail is forwarded. Falls back to FORM_TO when unset.
FORWARD_TO=you@personal-inbox.com

# ---------------------------------------------------------------------------
# Optional desk provider (Slack, Discord, Zapier, help desk)
# ---------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Rate limiting (requests per window per IP; webhooks are exempt)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
