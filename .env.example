# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (Supabase)
# Leave blank locally to write to ./data instead.
# Run db/schema.sql once in the Supabase SQL Editor to create the tables.
# ---------------------------------------------------------------------------
SUPABASE_URL=
# Must be the service_role key. The anon key cannot write: row level security
# is enabled with no public policies. Server side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# VITE_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL are accepted as URL aliases.

# Override where local file storage writes (defaults to ./data, /tmp on Vercel)
DATA_DIR=

# ---------------------------------------------------------------------------
# Outgoing email (Resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Where enquiries and chat notifications are delivered.
FORM_TO=you@yourdomain.com
# Verified sender in Resend. onboarding@resend.dev works for testing.
FORM_FROM=Merkel Website <onboarding@resend.dev>

# Legacy aliases, still honoured if FORM_TO / FORM_FROM are unset.
# CONTACT_NOTIFY_EMAIL=
# NOTIFY_FROM=

# Send a notification for every live-chat message. Set to "off" to silence.
CHAT_NOTIFY=on

# ---------------------------------------------------------------------------
# Inbound email (Resend receiving + forwarding)
# ---------------------------------------------------------------------------
# Signing secret from the Resend webhook. Requests without a valid signature
# are rejected with 401, so the endpoint stays closed until this is set.
RESEND_WEBHOOK_SECRET=

# The address that receives mail, e.g. studio@yourdomain.com
MAILBOX_ADDRESS=

# Where received mail is forwarded. Falls back to FORM_TO when unset.
FORWARD_TO=you@personal-inbox.com

# ---------------------------------------------------------------------------
# Optional desk provider (Slack, Discord, Zapier, help desk)
# ---------------------------------------------------------------------------
NOTIFY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Rate limiting (requests per window per IP; the inbound webhook is exempt)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
