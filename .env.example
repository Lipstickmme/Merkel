# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Storage
# Leave blank for local development: enquiries and chats are written to ./data
# In production (Vercel) connect a KV / Upstash Redis store and Vercel injects
# these automatically. Either naming pair works.
# ---------------------------------------------------------------------------
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Override where filesystem storage writes (defaults to ./data, or /tmp on Vercel)
DATA_DIR=

# ---------------------------------------------------------------------------
# Inbox notifications (optional; both channels are independent)
# ---------------------------------------------------------------------------
# 1. Email via Resend  (https://resend.com - free tier)
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=you@yourdomain.com
# Must be a verified sender/domain in Resend. onboarding@resend.dev works for testing.
NOTIFY_FROM=Merkel Website <onboarding@resend.dev>

# 2. Webhook for a desk provider (Slack, Discord, Zapier, help desk, ...)
NOTIFY_WEBHOOK_URL=

# Send an email/webhook for every live-chat message. Set to "off" to silence.
CHAT_NOTIFY=on

# ---------------------------------------------------------------------------
# Rate limiting (requests per window per IP)
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
